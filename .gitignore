# Freqtrade rules
*.sqlite

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Test output
test_results.json

# Trained model weights and scalers are generated artifacts — not tracked.
# The directory itself is kept via its README.
saved_data/*
!saved_data/README.md

# NeuralNets/ is a nested standalone git repo with no remote. Decide later
# whether to promote it to a submodule (needs a remote URL) or absorb its
# files into this repo (needs its .git/ removed first).
NeuralNets/

# macOS Finder metadata
.DS_Store

# Obsidian vault config for docs/ — local editor state, not content.
docs/.obsidian/

# feature 007: generated per-fold strategy classes and params (build artefacts)
# run_arm.py resolves a fold class to its FAMILY dir and symlinks only top-level *.py,
# so generated fold classes must sit directly in NNNC/ — a _wf/ subdir would never be found.
NNNC/NNNC_WF_f*.py
NNNC/NNNC_WF_f*.json
NNMT/NNMT_WF_f*.py
NNMT/NNMT_WF_f*.json

# feature 010: per-fold warm-start classifiers are generated artefacts
saved_data/labelfree_warmstart/

# Feature 013 (brief 05) evaluation sidecar — ~60 MB for one 48,000-evaluation run.
# R6's design keeps the full history OUT of git; the shared trials.jsonl carries a
# one-line summary row with this file's line count and sha256 instead.
research/labelfree/es/history.jsonl

# Feature 014 (brief 06) path banks — 1,000 resampled panels over ten folds is large, and the
# bank is reproducible from its recorded provenance. Feature 013's 60 MB sidecar was untracked
# but not ignored until an analyze pass caught it; this one is ignored up front.
research/labelfree/stress/banks/
